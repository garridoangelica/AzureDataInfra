				"dependsOn": [
					{
						"activity": "Extract SFTP To Lakehouse Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "DivisionFilter",
						"type": "DataFlowReference",
						"parameters": {
							"parameter1": {
								"value": "'@{pipeline().parameters.parameter1}'",
								"type": "Expression"
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			}
		],
		"parameters": {
			"parameter1": {
				"type": "string",
				"defaultValue": "sample"
			}
		},
